# Firebase Admin SDK service-account JSON (stringified single line).
# Generate one at https://console.firebase.google.com/project/kolado-mis/settings/serviceaccounts/adminsdk
# This is used server-side only (session cookies, user provisioning) and must
# never be exposed to the client bundle.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Payaza server-side payment configuration. Never expose these in the mobile app.
PAYAZA_MODE=test
PAYAZA_API_KEY=PZ78-TEST-REPLACE_ME
PAYAZA_PUBLIC_KEY=PZ78-PKTEST-REPLACE_ME
PAYAZA_WEBHOOK_SECRET=replace-with-payaza-webhook-secret
# Payaza Ghana bank/network code, configured by Payaza for the merchant account.
PAYAZA_GH_MOMO_BANK_CODE=replace-with-payaza-gh-bank-code
# Decimal GHS amount configured for a clinician appointment.
PAYAZA_APPOINTMENT_AMOUNT_GHS=50
# Public HTTPS API origin used by the mobile app, e.g. https://cms.example.com
EXPO_PUBLIC_CMS_API_URL=https://replace-with-your-cms-host
